{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No DOM and no Node types: the sim must run unchanged in browsers and Node (invariants 1-2).
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src"],
  // Tests run in Node and are type-checked by the root tsconfig.json.
  "exclude": ["src/**/*.test.ts"]
}
